{
  "compilerOptions": {
    "target": "es2015",
    "module": "es2020",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "lib": [
      "es2015",
      "dom"
    ],
    "strict": true,
    "noEmit": true,
    "sourceMap": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "verbatimModuleSyntax": false,
    "paths": {
      // Two type-only redirects, both working around how the packages ship
      // their declarations. Webpack resolves the real modules on its own.
      //
      // `@hugeicons/core-free-icons` sets `typings` AND a `typesVersions`
      // pattern of `*` -> `./dist/types/*`, so TypeScript takes the path from
      // the first and runs it through the second, ending up looking for
      // `dist/types/dist/types/index.d.ts`.
      //
      // lucide keeps its declarations at `dist/lucide-react.d.ts` rather than
      // beside the ESM entry, which is the file the icon shim imports so that
      // named imports stay tree-shakeable.
      "@hugeicons/core-free-icons": [
        "./node_modules/@hugeicons/core-free-icons/dist/types/index.d.ts"
      ],
      "lucide-react/dist/esm/lucide-react.js": [
        "./node_modules/lucide-react/dist/lucide-react.d.ts"
      ],
      "@/*": [
        "./resources/scripts/*"
      ],
      "@definitions/*": [
        "./resources/scripts/api/definitions/*"
      ],
      "@feature/*": [
        "./resources/scripts/components/server/features/*"
      ]
    },
    "plugins": [
      {
        "name": "typescript-plugin-tw-template"
      }
    ],
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "include": [
    "./resources/scripts/**/*"
  ],
  "exclude": [
    "/node_modules/"
  ]
}
